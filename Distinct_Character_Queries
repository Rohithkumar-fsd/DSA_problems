import java.util.*;
public class Main {
    static class Node{
        int count[]=new int[26];
        Node()
        {
            
        }
    }
    public static void main(String[] args) {
        Scanner scan=new Scanner(System.in);
        String s1=scan.nextLine();
        StringBuilder s=new StringBuilder(s1);
        // scan.nextLine();
        int q=scan.nextInt();
        Node []tree=new Node[4*s.length()];
        build(s.toString(),0,s.length()-1,0,tree);
        for(int i=0;i<q;i++)
        {
            int type=scan.nextInt();
            if(type==1)
            {
                int pos=scan.nextInt();
                char ch=scan.next().charAt(0);
                update(ch,pos-1,tree,0,s.length()-1,0,s.toString());
                s.setCharAt(pos-1, ch);
            }
            else{
                int l=scan.nextInt()-1;
                int r=scan.nextInt()-1;
                Node res=query(0,s.length()-1,0,tree,l,r);
                int fre[]=res.count;
                int cnt=0;
                for(int j=0;j<26;j++)
                {
                    if(fre[j]>0)
                    {
                        cnt++;
                    }
                }
                System.out.println(cnt);
            }
            // System.out.println(s.toString());
        }
    }
    static void build(String s,int low,int high,int index,Node[]tree)
    {
        if(low==high)
        {
            tree[index] = new Node();
            tree[index].count[s.charAt(low)-'a']=1;
            return;
        }
        int mid=(low+high)/2;
        build(s,low,mid,2*index+1,tree);
        build(s,mid+1,high,2*index+2,tree);
        tree[index]=merge(tree[2*index+1],tree[2*index+2]);
    }
    static Node merge(Node l,Node r)
    {
        Node res=new Node();
        for(int i=0;i<26;i++)
        {
            res.count[i]=l.count[i]+r.count[i];
        }
        return res;
    }
    static Node query(int low,int high,int index,Node[]tree,int l,int r){
        if(l>high || r<low)
        {
            return new Node();
        }
        if(low>=l && high<=r)
        {
            return tree[index];
        }
        int mid=(low+high)/2;
        Node L=query(low,mid,2*index+1,tree,l,r);
        Node R=query(mid+1,high,2*index+2,tree,l,r);
        return merge(L,R);
    }
    static void update(char ch,int pos,Node[]tree,int low,int high,int index,String s)
    {
        if(low==high)
        {
            tree[index].count[s.charAt(pos)-'a']=0;
            tree[index].count[ch-'a']=1;
            return;
        }
        int mid=(low+high)/2;
        if(pos<=mid)
        {
            update(ch,pos,tree,low,mid,2*index+1,s);
        }
        else{
            update(ch,pos,tree,mid+1,high,2*index+2,s);
        }
        tree[index]=merge(tree[2*index+1],tree[2*index+2]);
    }
}
