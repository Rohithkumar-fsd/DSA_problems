import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner scan=new Scanner(System.in);
        int N=scan.nextInt();
        int arr[]=new int[N];
        for(int i=0;i<N;i++)
        {
            arr[i]=scan.nextInt();
        }
        int carry=0;
        int op=0;
        for(int i=arr.length-1;i>=0;i--)
        {
            int num=arr[i];
            int becomeZero=0-num;
            carry+=becomeZero;
            if(i-1 >=0)
            {
                arr[i-1]=arr[i-1]+carry;
                // carry=0;
            }
            op+=Math.abs(becomeZero);
        }
        System.out.println(op);
    }
}
