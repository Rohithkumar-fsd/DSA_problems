import java.util.*;
import java.time.*;
import java.time.format.*;
import java.time.temporal.*;
public class Main {
    public static void main(String[] args) {
        Scanner scan=new Scanner(System.in);
        int arr[]=new int[12];
        int fre[]=new int[10];
        for(int i=0;i<12;i++)
        {
            arr[i]=scan.nextInt();
            fre[arr[i]]++;
        }
        LocalDateTime curr=LocalDateTime.of(2018,12,31,23,59);
        LocalDateTime end=LocalDateTime.of(2018,1,1,0,0);
        
        DateTimeFormatter fmt=DateTimeFormatter.ofPattern("MMddHHmm");
        String ans="";
        
        while(!curr.isBefore(end))
        {
            String s=curr.format(fmt);
            
            if(form(s,fre,arr))
            {
                ans=s;
                break;
            }
            curr=curr.minusMinutes(1);
        }
        if(ans.isEmpty())
        {
            System.out.println("0");
            return;
        }
        System.out.println(ans.substring(0,2)+"/"+ans.substring(2,4)+" "+ans.substring(4,6)+":"+ans.substring(6));
    }
    static boolean form(String s,int fre[],int arr[])
    {
        int copy[]=fre.clone();
        for(char ch:s.toCharArray())
        {
            int no=ch-'0';
            if(copy[no]>0)
            {
                copy[no]--;
            }
            else{
                return false;
            }
        }
        return true;
    }
}
