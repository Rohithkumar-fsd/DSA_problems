    TreeNode first;
    TreeNode middle;
    TreeNode last;
    TreeNode prev;
    public void recoverTree(TreeNode root) {
        inorder(root);
        if(last!=null)
        {
            int value=first.val;
            first.val=last.val;
            last.val=value;
        }
        else{
            int value=first.val;
            first.val=middle.val;
            middle.val=value;
        }
