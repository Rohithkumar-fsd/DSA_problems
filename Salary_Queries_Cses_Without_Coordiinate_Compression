

import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class SalaryQueries {
    public static void main(String[] args) {
        Scanner scan=new Scanner(System.in);
        int N=scan.nextInt();
        int Q= scan.nextInt();
        long arr[]=new long[N+1];
        int  maxvalue=Integer.MIN_VALUE;
        Map<Integer,Integer> fre=new HashMap<>();

        for(int i=1;i<=N;i++)
        {
            arr[i]=scan.nextLong();
            maxvalue=Math.max(maxvalue,(int)arr[i]);
            fre.put((int)arr[i],fre.getOrDefault((int)arr[i],0)+1);
        }
        long seg[]=new long[4*maxvalue];
        scan.nextLine();
        build(seg,arr,1,1,maxvalue,fre);
        StringBuilder res=new StringBuilder();
        for(int i=0;i<Q;i++)
        {
          String input=scan.nextLine();
          String split[]=input.split("\\s+");
          String type=split[0];
          if(type.equals("?"))
          {
              int l=Integer.parseInt(split[1]);
              int r=Integer.parseInt(split[2]);
              long ans=query(seg,1,1,maxvalue,l,r);
              res.append(ans+"\n");
          }
          else{
              int pos=Integer.parseInt(split[1]);
              int value=Integer.parseInt(split[2]);
              update(seg,arr,1,1,maxvalue,pos,value);
              arr[pos] = value;
          }
        }
        System.out.println(res.toString());


    }
    static void build(long seg[],long arr[],int index,int low,int high,Map<Integer,Integer>fre)
    {
        if(low==high)
        {
            if(fre.containsKey(low))
            {
                seg[index]=fre.get(low);
            }
            return;
        }
        int mid=(low+high)/2;
        build(seg,arr,2*index,low,mid,fre);
        build(seg,arr,2*index+1,mid+1,high,fre);
        seg[index]=seg[2*index]+seg[2*index+1];
    }
    static void update(long seg[],long arr[],int index,int low,int high,int pos,int newvalue)
    {
        if(low==high)
        {
            long oldvalue=arr[pos];
            if(low==oldvalue)
            {
                seg[index]-=1;
            }
            if(low==newvalue)
            {
                seg[index]+=1;
            }
            return;
        }
        int mid=(low+high)/2;
        update(seg,arr,2*index,low,mid,pos,newvalue);
        update(seg,arr,2*index+1,mid+1,high,pos,newvalue);
        seg[index]=seg[2*index]+seg[2*index+1];
    }
    static long query(long seg[],int index,int low,int high,int l,int r)
    {
        if(low>=l && high<=r)
        {
            return seg[index];
        }
        if(high<l || low>r)
        {
            return 0;
        }
        int mid=(low+high)/2;
        long left=query(seg,2*index,low,mid,l,r);
        long right=query(seg,2*index+1,mid+1,high,l,r);
        return left+right;
    }

}
