import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner scan=new Scanner(System.in);
        int N=scan.nextInt();
        int arr[]=new int[N];
        int totalsum=0;
        for(int i=0;i<N;i++)
        {
            arr[i]=scan.nextInt();
            totalsum+=arr[i];
        }
        Arrays.sort(arr);
        int ans1=totalsum-(arr[0]*N);
        int ans2=Math.abs(totalsum-arr[arr.length-1]*N);
        System.out.println(Math.min(ans1,ans2));
        
    }
}
