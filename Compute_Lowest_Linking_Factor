import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner scan=new Scanner(System.in);
         int N=scan.nextInt();
        int arr[]=new int[N+1];
        for(int i=1;i<=N;i++)
        {
            arr[i]=scan.nextInt();
        }
        long prefix1[]=new long[N+1];
        long sum=0;
        for(int i=1;i<=N;i++)
        {
            sum+=arr[i];
            prefix1[i]=sum;
        }
        // for(int i=1;i<=N;i++)
        // {
        //     System.out.print(prefix1[i]+" ");
        // }
        // System.out.println();
        // for(int i=1;i<=N;i++)
        // {
        //     System.out.print(prefix2[i]+" ");
        // }
        // System.out.println();
        int Q=scan.nextInt();
        for(int i=0;i<Q;i++)
        {
            long ans=0;
            int h1=scan.nextInt();
            int h2=scan.nextInt();
            int l1=h1-1;
            long sum1=prefix1[l1];
            int l2=h1+1;
            int r2=h2-1;
            long sum2=prefix1[r2]-prefix1[l2-1];
            ans+=(arr[h2]*(r2-l2+1) -sum2);
            ans+=(arr[h1]*(l1) - sum1);
            int l3=h2+1;
            int r3=N;
            long sum3=prefix1[r3]-prefix1[l3-1];
            ans+=(arr[r3]*(r3-l3+1) -sum3);
            // System.out.println(sum1+" "+sum2+" "+sum3);
            System.out.println(ans);
        }
    }
}
