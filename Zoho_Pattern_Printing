import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner scan=new Scanner(System.in);
        int N=scan.nextInt();
        for(int i=1;i<=N;i++)
        {
            int count=i;
            int inc=0;
            for(int k=1;k<=N-i;k++)
            {
                System.out.print("   ");
            }
            for(int j=1;j<=i;j++)
            {
                System.out.print("  "+count+"");
                count+=(4-inc);
                inc++;
            }
            System.out.println();
        }
    }
}
